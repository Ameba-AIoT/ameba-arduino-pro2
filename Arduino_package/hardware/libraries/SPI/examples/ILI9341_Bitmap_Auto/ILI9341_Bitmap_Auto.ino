/*
 * ILI9341 single-image display, converted from a .bmp at build time.
 *
 * Drop any .bmp beside this sketch (16/24/32-bit, up to 240x320) and it is
 * converted to auto_bitmap.h on the next build -- no manual .hpp step.
 *
 * Example Guide: TBD
 */

#include "SPI.h"
#include "AmebaILI9341.h"

// Generated by bmp2hpp. The script always writes this header -- a stub
// with AUTO_BITMAP_PRESENT 0 when there is no usable .bmp -- so the sketch never
// has to test for the file's existence and builds either way.
#if __has_include("auto_bitmap.h")
#include "auto_bitmap.h"
#else
#define AUTO_BITMAP_PRESENT 0
#endif

#define TFT_RESET 5
#define TFT_DC    4
#define TFT_CS    SPI_SS    // use SPI1_SS with &SPI1 below

AmebaILI9341 tft = AmebaILI9341(TFT_CS, TFT_DC, TFT_RESET);

#define ILI9341_SPI_FREQUENCY 20000000

void setup()
{
    Serial.begin(115200);
    Serial.println("ILI9341 bitmap (auto-converted) test");

    SPI.setDefaultFrequency(ILI9341_SPI_FREQUENCY);

    tft.begin();
    tft.clr();

#if AUTO_BITMAP_PRESENT
    tft.drawBitmap(0, 0, AUTO_BITMAP_WIDTH, AUTO_BITMAP_HEIGHT, auto_bitmap);
    Serial.print("drew ");
    Serial.print(AUTO_BITMAP_NAME);
    Serial.print(" (");
    Serial.print(AUTO_BITMAP_WIDTH);
    Serial.print("x");
    Serial.print(AUTO_BITMAP_HEIGHT);
    Serial.println(")");
#else
    Serial.print("No image drawn: ");
    Serial.println(AUTO_BITMAP_NAME);
    Serial.println("Put a .bmp beside this sketch and rebuild.");
#endif
}

void loop()
{
}
